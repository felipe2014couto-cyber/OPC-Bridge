# Copy to /etc/opc-bridge/opc-bridge-server.env and fill in deployment values.
OPC_BRIDGE_HOST=0.0.0.0
OPC_BRIDGE_PORT=8443
DATABASE_URL=
OPC_BRIDGE_TLS_CERTFILE=/etc/opc-bridge/tls/server.crt
OPC_BRIDGE_TLS_KEYFILE=/etc/opc-bridge/tls/server.key
OPC_BRIDGE_LOG_LEVEL=INFO
OPC_BRIDGE_LOG_FORMAT=%(asctime)s %(levelname)s %(name)s %(message)s
OPC_BRIDGE_RETENTION_DAYS=7

# Optional. When set, starts the embedded administrative API on loopback.
# Store the actual value only in the protected environment file.
# ADMIN_API_TOKEN=
# ADMIN_API_PORT=8081
